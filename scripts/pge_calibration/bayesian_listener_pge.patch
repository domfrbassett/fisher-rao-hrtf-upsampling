+def test_barumerli2023pge_features_and_covariance():
+    """PGE keeps positive adjacent-band slopes and matches covariance size."""
+    spectral = np.array([[[1.0, 4.0], [3.0, 2.0], [2.0, 7.0]]])
+    pge = Barumerli2023pge(
+        coords=None,
+        itd=np.array([[0.1]]),
+        ild=np.array([[2.0]]),
+        spectral_cues=spectral,
+        freqs=np.array([1000.0, 2000.0, 8000.0]),
+    )
+
+    np.testing.assert_allclose(pge.spectral_gradient,
+                               [[[2.0, 0.0], [0.0, 5.0]]])
+    np.testing.assert_allclose(pge.freqs, [np.sqrt(2e6), 4000.0])
+    assert pge.features.shape == (1, 6)
+    sigma = pge.sigma_matrix({
+        'sigma_itd': 0.569,
+        'sigma_ild': 1.0,
+        'sigma_spectral': 1.25,
+    })
+    assert sigma.shape == (6, 6)
+
+
+def test_compute_template_positive_gradient_convention():
+    """PGE target and interpolated template retain compatible feature sizes."""
+    am = BayesianListener(get_sofa_file())
+    am.compute_target(convention='barumerli2023pge', use_cache=False)
+    am.compute_template(interpolation='SH', use_cache=False)
+
+    assert isinstance(am.target, Barumerli2023pge)
+    assert isinstance(am.template, Barumerli2023pge)
+    assert am.target.features.shape[1] == am.template.features.shape[1]
+    assert am.target.freqs.size == am.target._input_freqs.size - 1
+    assert am.target.spectral_cues is not None
+    assert am.template.spectral_cues is None
+    assert am.template.spectral_gradient.shape[1] == am.target.freqs.size
 
 
